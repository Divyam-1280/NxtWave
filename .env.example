# NIAT Project Mirror — Environment Configuration Template
# Duplicate this file as .env and fill in your actual API keys

# Groq API Key (https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs Conversational Voice API (https://elevenlabs.io)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Telemetry & Lead Persistence (https://supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
